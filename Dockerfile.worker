FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies (ffmpeg-static bundles the binary)
COPY package.json package-lock.json* ./
RUN npm ci

# Copy source (tsx reads tsconfig.json for path aliases)
COPY tsconfig.json ./
COPY src ./src

# Railway injects env vars directly — dotenv.config() will simply find no file and move on
CMD ["npx", "tsx", "src/worker/index.ts"]
