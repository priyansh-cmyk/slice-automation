# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Vercel / Next.js: use the Supabase pooler URL (Transaction mode, port 6543)
# Format: postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Railway worker only: direct connection (Session mode, port 5432) — required for pg_advisory_lock
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_DIRECT_URL=

# ── useapi.net Google Flow ────────────────────────────────────────────────────
USEAPI_TOKEN=
GOOGLE_FLOW_EMAIL=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# 64 hex chars (32 bytes) for AES-256-GCM token encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Development flags ─────────────────────────────────────────────────────────
MOCK_USEAPI=false

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Bucket names (create these in Supabase Dashboard → Storage)
SUPABASE_BUCKET_UPLOADS=uploads         # base reference images
SUPABASE_BUCKET_VIDEOS=videos           # generated video clips
SUPABASE_BUCKET_COMPILATIONS=compilations # compiled full videos
