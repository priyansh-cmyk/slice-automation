# useapi.net Google Flow
USEAPI_TOKEN=
GOOGLE_FLOW_EMAIL=

# Higgsfield MCP (Phase 3)
HIGGSFIELD_MCP_ENDPOINT=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_OAUTH_CLIENT_ID=vOk5B5uaBOfqxfWO
HIGGSFIELD_TOKEN_PATH=./data/higgsfield-tokens.json
HIGGSFIELD_MODEL_PATH=

# Storage
STORAGE_DIR=./storage
DATABASE_PATH=./data/app.db

# Security — 64 hex chars (32 bytes) for AES-256-GCM token encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Development flags — set MOCK_HIGGSFIELD=true until Phase C auth flow is complete
MOCK_HIGGSFIELD=true
MOCK_USEAPI=false

# Upload stale threshold (ms) — default 5 minutes; calibrate after first uploads
UPLOAD_STALE_AFTER_MS=300000
